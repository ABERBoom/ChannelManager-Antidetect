{
  "manifest_version": 2,
  "name": "WebRTC Guard (Dynamic)",
  "version": "1.0",
  "description": "Dynamically fetches proxy IP and spoofs WebRTC without static hardcoding.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "webrtc-guard-dynamic@channelmanager.local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}